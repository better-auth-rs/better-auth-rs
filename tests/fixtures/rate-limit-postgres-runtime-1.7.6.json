{
  "version": "1.7.6",
  "database": "postgres",
  "cases": [
    {
      "name": "default",
      "configuration": {},
      "rule": {
        "window": 600,
        "max": 100
      },
      "key": "192.0.2.10|/ordinary-counter",
      "steps": [
        {
          "allowed": true,
          "retryAfter": null,
          "row": {
